# ------------------------------------------------------------------
# Copie para .env e preencha. NUNCA versionar o .env real.
# ------------------------------------------------------------------

# Google Gemini (usado somente neste backend)
GEMINI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-3.8-flash
# Fallback automático se o principal atingir cota do free tier.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Embeddings locais (sem chave de API; baixado na primeira execução)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Segurança — origens permitidas (separadas por vírgula)
CORS_ORIGINS=af://af-desktop

# Upload
MAX_UPLOAD_BYTES=5242880

# Ambiente
ENVIRONMENT=local
LOG_LEVEL=INFO

# Fase 2 — MongoDB (deixe vazio para usar repositório em memória)
DATABASE_URL=
