      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const input = $input.first().json;\nconst body = input.body && typeof input.body === 'object' && !Array.isArray(input.body) ? input.body : {};\nconst statuses = ['ATIVA', 'VENCIDA', 'PENDENTE', 'CANCELADA'];\nconst cidade = typeof body.cidade === 'string' ? body.cidade : '';\nconst status = typeof body.status === 'string' ? body.status : '';\nconst medicationTypeOk = body.medicamento === undefined || body.medicamento === null || typeof body.medicamento === 'string';\nconst medicamento = typeof body.medicamento === 'string' ? body.medicamento.trim() : null;\nconst perguntaOk = body.pergunta === undefined || typeof body.pergunta === 'string';\nconst pergunta = perguntaOk && typeof body.pergunta === 'string' ? body.pergunta.trim().slice(0, 1000) : '';\nconst permitido = cidade === 'Santo Antônio de Jesus' && statuses.includes(status) && medicationTypeOk && perguntaOk && (!medicamento || medicamento.length <= 100);\nconst motivo = permitido ? null : cidade !== 'Santo Antônio de Jesus' ? 'perfil sem permissão para a cidade solicitada' : !statuses.includes(status) ? 'status inválido' : !medicationTypeOk || (medicamento && medicamento.length > 100) ? 'medicamento inválido' : 'pergunta inválida';\nconst solicitacaoId = `${Date.now()}-${Math.random().toString(16).slice(2)}`;\nconst perguntaFinal = pergunta || `Consulte LMEs com status ${status}${medicamento ? ` para ${medicamento}` : ''} em ${cidade}.`;\nreturn [{ json: { solicitacao_id: solicitacaoId, usuario: 'teste_farmaceutico_sai', cidade, status, medicamento: medicamento || null, pergunta: perguntaFinal, view: permitido ? 'pacientes_sai' : null, permitido, motivo } }];"
        },
        "type": "n8n-nodes-base.code",
