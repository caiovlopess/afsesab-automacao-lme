      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const request = $('Validar e autorizar').first().json;\nconst mask = (value) => {\n  if (typeof value === 'string') return value.replace(/\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}/g, (cpf) => `***.***.***-${cpf.slice(-2)}`).replace(/\\b\\d{11}\\b/g, (cpf) => `***.***.***-${cpf.slice(-2)}`);\n  if (Array.isArray(value)) return value.map(mask);\n  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, mask(item)]));\n  return value;\n};\nconst registros = $input.all().map((item) => item.json).filter((record) => Object.keys(record).length > 0).map(mask);\nreturn [{ json: { ...request, registros } }];"
        },
